# ──────────────────────────────────────────────────────────────
# Vinci AI — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local. Only this .env.example is checked in.
# ──────────────────────────────────────────────────────────────

# Supabase (Auth + Postgres + Storage)
# Project Settings → API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Prisma — Supabase connection strings
# Settings → Database → Connection string (use "Transaction" pooler for DATABASE_URL,
# and the direct connection, port 5432, for DIRECT_URL — required for migrations)
DATABASE_URL=
DIRECT_URL=

# OpenAI (chat + vision)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o

# Supabase Storage bucket names (created via scripts/setup-storage.ts)
SUPABASE_STORAGE_BUCKET_COLLECTIBLES=collectible-images
SUPABASE_STORAGE_BUCKET_AVATARS=avatars
SUPABASE_STORAGE_BUCKET_EXPORTS=exports

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Vinci AI

# Rate limiting (optional — falls back to in-memory limiter if unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
